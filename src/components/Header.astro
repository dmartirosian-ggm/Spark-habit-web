---
import { NAV_LINKS } from '../data/nav';
import { SITE } from '../site';

const path = Astro.url.pathname;
const current = (href: string) => (path.startsWith(href) ? 'page' : undefined);
---

<header class="site-header">
  <div class="wrap">
    <a class="brand" href="/"><img src="/assets/apple-touch-icon.png" alt="" width="36" height="36" />Spark</a>
    <nav class="site-nav" aria-label="Main">
      {NAV_LINKS.map((l) => <a href={l.href} aria-current={current(l.href)}>{l.label}</a>)}
    </nav>
    {
      SITE.appStoreUrl && (
        <a class="btn btn-ink header-cta" href={SITE.appStoreUrl}>
          <svg aria-hidden="true"><use href="#apple" /></svg>
          Download
        </a>
      )
    }
    <details class="menu">
      <summary>Menu</summary>
      <nav aria-label="Main (mobile)">
        {NAV_LINKS.map((l) => <a href={l.href} aria-current={current(l.href)}>{l.label}</a>)}
        <a href="/help/" aria-current={current('/help/')}>Help</a>
      </nav>
    </details>
  </div>
</header>
