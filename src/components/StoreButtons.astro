---
import { SITE } from '../site';

interface Props {
  tone?: 'ink' | 'spark';
}
const { tone = 'ink' } = Astro.props;
// Only stores with a live listing get a button.
const stores = [
  { name: 'App Store', icon: 'apple', url: SITE.appStoreUrl },
  { name: 'Google Play', icon: 'play', url: SITE.playStoreUrl },
].filter((s) => s.url);
---

<div class="store-buttons">
  {
    stores.map((s) => (
      <a class:list={['btn', 'btn-store', `btn-${tone}`]} href={s.url}>
        <svg aria-hidden="true"><use href={`#${s.icon}`} /></svg>
        <span>
          <small>Download on the</small>
          {s.name}
        </span>
      </a>
    ))
  }
</div>
